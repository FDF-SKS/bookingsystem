# Sørg for at tekstfiler altid har LF i arbejdsmappen – også på Windows.
# Ellers bliver f.eks. src/entrypoint.sh checket ud med CRLF, og containeren
# fejler ved start med:
#   exec /app/entrypoint.sh: no such file or directory
* text=auto eol=lf

# Scripts og konfiguration der kører i Linux-containere
*.sh     text eol=lf
dockerfile text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.conf   text eol=lf

# Windows-specifikke scripts skal fortsat have CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
