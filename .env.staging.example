# =============================================================================
# STAGING (Docker)
#
# Kopiér til .env.staging og ret værdierne:
#     cp .env.staging.example .env.staging
#     chmod 600 .env.staging
#
# Alle værdier herunder er dummy-værdier og må gerne ligge offentligt på GitHub.
# Filen bruges når ENVIRONMENT=staging:
#   - Database: Postgres i containeren "db"
#   - Cache/Constance/Celery-broker: Redis i containeren "redis"
#   - Webserver: gunicorn (se src/entrypoint.sh)
#   - Email: Amazon SES
#
# VIGTIGT: Brug bevidst ugyldige SES-nøgler på staging, så der ikke kan sendes
# rigtige emails til rigtige brugere. Nøglerne her er attrapper og virker ikke.
#
# Kommandoer læser denne fil med --env-file .env.staging
# =============================================================================

ENVIRONMENT=staging
DEBUG=False

# --- Django ---------------------------------------------------------------
# Generér en unik værdi pr. miljø:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-output-of-secrets-token-urlsafe
DJANGO_ALLOWED_HOSTS=run.seniorkursussletten.dk,localhost,127.0.0.1

# Absolut base-URL uden afsluttende slash. Bruges i links i emails.
SITE_URL=https://run.seniorkursussletten.dk
# Både staging-domænet og den lokale Docker-adresse (http://localhost:8001).
CSRF_TRUSTED_ORIGINS=https://run.seniorkursussletten.dk,http://localhost:8001,http://127.0.0.1:8001

# --- Database (Postgres, service "db") -------------------------------------
DATABASE_NAME=booking_db
DATABASE_USERNAME=booking_user
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis (cache, Constance og Celery-broker) -----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1
# Valgfri: Celery-brokeren (default er redis://<REDIS_HOST>:<REDIS_PORT>/2)
# CELERY_BROKER_URL=redis://redis:6379/2

# --- Email (Amazon SES) ----------------------------------------------------
DEFAULT_FROM_EMAIL=staging@example.com
AWS_SES_REGION_NAME=eu-north-1
# Attrap-nøgler: SES afviser dem, og staging kan dermed ikke sende rigtig post.
AWS_SES_ACCESS_KEY_ID=invalid-staging-access-key-id
AWS_SES_SECRET_ACCESS_KEY=invalid-staging-secret-access-key
# Navnet på den SES configuration set der sender bounce/complaint-events til SNS.
AWS_SES_CONFIGURATION_SET=
