# =============================================================================
# LOKAL UDVIKLING
#
# Kopiér til .env og kør Django direkte på din maskine:
#     cp .env.example .env
#
# Alle værdier herunder er dummy-værdier og må gerne ligge offentligt på GitHub.
# Filen bruges kun når ENVIRONMENT=dev:
#   - Database: SQLite (src/db.sqlite3)        -> ingen Postgres nødvendig
#   - Email:    printes i terminalen           -> ingen SMTP/SES nødvendig
#   - Celery:   kører inline (eager)           -> ingen Redis nødvendig
#
# Skal du køre staging i Docker, brug .env.staging.example i stedet.
# =============================================================================

ENVIRONMENT=dev

# --- Django ---------------------------------------------------------------
# Kun til udvikling. Generér en ny til staging/produktion:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-before-deploying
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Absolut base-URL uden afsluttende slash. Bruges i links i emails.
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Email ----------------------------------------------------------------
# I dev sendes emails til konsollen, så afsenderen er kun til pynt.
DEFAULT_FROM_EMAIL=dev@example.com

# -----------------------------------------------------------------------------
# Følgende bruges kun når ENVIRONMENT=staging eller production.
# De er kommenteret ud her for at gøre det tydeligt, at dev ikke bruger dem.
# Se .env.staging.example for et komplet eksempel.
# -----------------------------------------------------------------------------
# DATABASE_NAME=booking_db
# DATABASE_USERNAME=booking_user
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=db
# DATABASE_PORT=5432
# REDIS_HOST=redis
# REDIS_PORT=6379
# AWS_SES_REGION_NAME=eu-north-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_CONFIGURATION_SET=
